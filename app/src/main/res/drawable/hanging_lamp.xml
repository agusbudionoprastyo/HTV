<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="128dp"
    android:height="128dp"
    android:viewportWidth="128"
    android:viewportHeight="128">

    <!-- Wire -->
    <path
        android:pathData="M 63,0 L 65,0 L 65,30 L 63,30 Z"
        android:fillColor="#FF222222" />

    <!-- Outer dome (Matte black) - DRAWN FIRST -->
    <path android:pathData="M 14,80 C 14,52.5 36.5,30 64,30 C 91.5,30 114,52.5 114,80 C 114,84.4 91.6,88 64,88 C 36.4,88 14,84.4 14,80 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="14"
                android:startY="30"
                android:endX="114"
                android:endY="96">
                <item android:offset="0.0" android:color="#FF404040" />
                <item android:offset="0.4" android:color="#FF222222" />
                <item android:offset="1.0" android:color="#FF111111" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner gold interior (Unlit) - DRAWN ON TOP -->
    <path android:pathData="M 14,80 C 14,75.6 36.4,72 64,72 C 91.6,72 114,75.6 114,80 C 114,84.4 91.6,88 64,88 C 36.4,88 14,84.4 14,80 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="64"
                android:centerY="80"
                android:gradientRadius="45">
                <item android:offset="0.0" android:color="#FF999999" />
                <item android:offset="1.0" android:color="#FF444444" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
